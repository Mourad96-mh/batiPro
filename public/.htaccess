# Configuration Apache/LiteSpeed pour l'hébergement mutualisé (Hostinger).
# Ce fichier est dans `public/`, donc Next le recopie tel quel dans `out/` :
# il part avec le site à chaque `npm run build`, rien à réinstaller à la main.
#
# L'export est statique et `trailingSlash: true` : /services/ → /services/index.html
# est servi nativement par le serveur, aucune réécriture d'URL n'est nécessaire.

# --- URL canonique : https:// + sans www ---------------------------------
# Doit correspondre à COMPANY.siteUrl (src/lib/dictionary.js), sinon les
# balises canonical, le sitemap et le JSON-LD désignent une URL qui redirige.
# ⚠️ À n'activer qu'une fois le certificat SSL délivré (hPanel → SSL), sinon
#    la redirection envoie les visiteurs vers un https:// qui n'existe pas.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → sans www, en une seule redirection (301, en https)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Page 404 ------------------------------------------------------------
ErrorDocument 404 /404.html

# --- Cache ---------------------------------------------------------------
# Les fichiers de /_next/static/ portent un hash dans leur nom : ils ne
# changent jamais à contenu égal, donc cache maximal. Le HTML, lui, doit
# rester revalidé à chaque visite pour que les mises à jour soient visibles.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Divers --------------------------------------------------------------
Options -Indexes
AddDefaultCharset UTF-8
